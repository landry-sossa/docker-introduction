# ==========================================
# ÉTAPE 1 : CONSTRUCTION (Vite + Node)
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# ==========================================
# ÉTAPE 2 : PRODUCTION (Nginx Alpine Durci)
# ==========================================
FROM nginx:alpine AS runner

# 1. Configuration Non-Root (AVANT de supprimer le shell)
RUN sed -i 's/listen  *80;/listen 8080;/g' /etc/nginx/conf.d/default.conf

# 2. Autorisations (Permissions) (AVANT de supprimer le shell)
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    chown -R nginx:nginx /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid

# 3. HARDENING : Destruction des outils de l'OS (LA TOUTE DERNIÈRE COMMANDE RUN)
# Après cette ligne, plus aucune commande RUN ne fonctionnera.
RUN rm -rf /sbin/apk /etc/apk /lib/apk /usr/share/apk /var/lib/apk && \
    rm -f /bin/sh /bin/ash /bin/wget /usr/bin/wget /usr/bin/curl

# 4. Récupération des fichiers statiques
# L'instruction COPY ne nécessite pas de shell, elle fonctionnera donc parfaitement ici.
COPY --from=builder /app/dist /usr/share/nginx/html



# 5. Abandon des droits administrateur
USER nginx

EXPOSE 8080

# 6. CONTOURNEMENT : On écrase l'entrypoint par défaut (qui nécessite /bin/sh)
# pour exécuter directement le binaire Nginx en C
ENTRYPOINT ["nginx", "-g", "daemon off;"]